rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: checks if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper: checks if user has the admin document in /admins/{uid}
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    // Admins Collection: Only authenticated admins can view list or read profiles.
    // An admin can read their own profile during login.
    match /admins/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Public Collections: Anyone can read; only authenticated admins can write/update/delete.
    match /books/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /blogs/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /pennames/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /reviews/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /genres/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /tropes/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Subscribers: Anyone can write (join the list); only admins can read or manage.
    match /subscribers/{document} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    // Connection test collection
    match /connection_tests/{document} {
      allow read, write: if isAdmin();
    }
  }
}
